#!/usr/bin/env bash
# A stand-in for the docker CLI, so supervision's container legs can be tested
# without a daemon. It answers only the two calls supervision makes.
#
# Controlled entirely by env vars, and every invocation is appended to
# FAKE_DOCKER_LOG so a test can assert that a leg ran — or, just as importantly,
# that it did not.
set -u

[ -n "${FAKE_DOCKER_LOG:-}" ] && printf '%s\n' "$*" >> "$FAKE_DOCKER_LOG"

case "${1:-}" in
  version)
    # Stands in for "is the daemon answering?" — the question that separates a
    # container that is gone from one this host simply cannot see.
    [ "${FAKE_DOCKER_DAEMON:-1}" = 1 ] || exit 1
    printf 'fake\n'
    ;;
  inspect)
    [ "${FAKE_DOCKER_DAEMON:-1}" = 1 ] || exit 1
    # `docker inspect --format <fmt> <name>`: the name is the last argument.
    for name in "$@"; do :; done
    [ "$name" = "${FAKE_DOCKER_CONTAINER:-}" ] || exit 1
    [ "${FAKE_DOCKER_EXISTS:-1}" = 1 ] || exit 1
    printf '%s %s\n' "${FAKE_DOCKER_RUNNING:-true}" "${FAKE_DOCKER_INSTANCE:-}"
    ;;
  stop)
    for name in "$@"; do :; done
    [ "$name" = "${FAKE_DOCKER_CONTAINER:-}" ] || exit 1
    printf '%s\n' "$name"
    ;;
  *)
    exit 1
    ;;
esac
